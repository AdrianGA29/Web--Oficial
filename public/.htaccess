Options -Indexes
DirectoryIndex index.html

RewriteEngine On

# Canonical domain: always use HTTPS and omit the www subdomain.
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\.temisatrile\.com$ [NC]
RewriteRule ^ https://temisatrile.com%{REQUEST_URI} [R=301,L]

# Consolidate superseded service pages into the current service architecture.
RewriteRule ^servicios/automatizacion-procesos(?:\.html)?/?$ /servicios/automatizacion/ [R=301,L,NE]
RewriteRule ^servicios/webs-interactivas-ia(?:\.html)?/?$ /servicios/desarrollo-web/ [R=301,L,NE]
RewriteRule ^servicios/presupuestacion-tecnica(?:\.html)?/?$ /servicios/ [R=301,L,NE]

# Redirect direct requests for generated HTML files to their clean URL.
RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
RewriteRule ^(.*/)?index\.html$ /$1 [R=301,L,NE]

RewriteCond %{THE_REQUEST} \s/+(.+)\.html[\s?] [NC]
RewriteRule ^(.+)\.html$ /$1/ [R=301,L,NE]

# Historical contact routes now point to the single contact section.
RewriteRule ^(?:contacto|diagnostico)/?$ /#contacto [R=301,L,NE]

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/plain "access plus 0 seconds"
  ExpiresByType application/xml "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"

  <FilesMatch "\.(?:css|js|mjs|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(?:webp|png|jpe?g|svg|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.(?:html|xml|txt)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

ErrorDocument 404 /404.html
